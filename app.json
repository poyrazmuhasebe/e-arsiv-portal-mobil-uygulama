{
  "expo": {
    "name": "e-Arşiv Portal",
    "slug": "earsiv-app",
    "version": "1.0.1-beta.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D17",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.poyrazmuhasebe.earsivportal",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "package": "com.poyrazmuhasebe.earsivportal",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D17",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 8
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "e-Arşiv Portal, uygulama kilidini açmak için Face ID kullanır."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0B0D17",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b0ad9b74-93d6-45ec-874e-9fb320da272b"
      }
    },
    "owner": "dursuncanmuhasebe"
  }
}
