{
  "expo": {
    "name": "e-Arşiv Portal",
    "slug": "earsiv-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D47A1",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.poyrazmuhasebe.earsivportal"
    },
    "android": {
      "package": "com.poyrazmuhasebe.earsivportal",
      "adaptiveIcon": {
        "backgroundColor": "#0D47A1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "e-Arşiv Portal, uygulama kilidini açmak için Face ID kullanır."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "b0ad9b74-93d6-45ec-874e-9fb320da272b"
      }
    },
    "owner": "dursuncanmuhasebe"
  }
}
