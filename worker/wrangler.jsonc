{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "earsiv-hesap",
  "main": "src/index.ts",

  // nodejs_compat, 2026-08-04 ve sonrası uyumluluk tarihlerinde zaten
  // varsayılan olarak açık; yine de okunabilirlik için açıkça yazılıyor.
  // scrypt (node:crypto) buna bağlı.
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Özel alan adı. Bu kaydı Wrangler kendisi oluşturur (Zone DNS + Workers
  // Routes izni gerekir). Adres uygulama derlemesine gömülüdür
  // (.env.example, eas.json) — DEĞİŞTİRİLİRSE YENİ APK GEREKİR.
  "routes": [
    {
      "pattern": "earsivfatura.poyrazmuhasebe.com",
      "custom_domain": true
    }
  ],

  // Wrangler'ın Cloudflare'e kullanım verisi göndermesi kapalı.
  "send_metrics": false,

  // Kayıtlar: console çıktısı tutulur (yalnızca sabit hata kodları yazılır),
  // ama istek üstverisi (URL, başlıklar, IP) KAYDEDİLMEZ. KVKK gerekçesi:
  // docs/hesap-sistemi.md → "Hangi veri nerede".
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "earsiv-hesap",
      // 2026-09-20'de `npx wrangler d1 create earsiv-hesap --jurisdiction eu`
      // ile oluşturuldu (bölge: EEUR, AB yetki alanı). Sır değildir, commit'lenir.
      //
      // ÖNEMLİ: burası boş bırakılmaz. Wrangler 4.45 ve sonrası, ID'si
      // yazılmamış bir binding için deploy sırasında KENDİSİ yeni bir
      // veritabanı oluşturabiliyor ve bu durumda jurisdiction (eu) seçimi
      // atlanır. Jurisdiction sonradan değiştirilemez.
      "database_id": "fbd00663-b549-4dd6-b945-4c9211794f82"
      // "remote": true KULLANILMAZ — yerel geliştirme kazara gerçek
      // veritabanına bağlanmasın diye.
    }
  ],

  // Sır OLMAYAN yapılandırma. Sırlar (OTURUM_IMZA_ANAHTARI, PEPPER)
  // `wrangler secret put` ile ya da git dışı .dev.vars ile verilir.
  "vars": {
    // Üretimde CORS tamamen kapalı. Yerel web önizlemesi için .dev.vars'ta
    // "http://localhost:8081" verilir. Wildcard hiçbir koşulda kullanılmaz.
    "CORS_IZIN_LISTESI": "",
    // Email Sending için onboard edilen alan adı: earsivfatura.poyrazmuhasebe.com
    // (cf-bounce MX/SPF/DKIM ve _dmarc kayıtları BU ALT ALAN ADINDA; apex
    // poyrazmuhasebe.com'in kendi SPF/DMARC kayıtlarına dokunulmadı).
    "POSTA_GONDEREN": "dogrulama@earsivfatura.poyrazmuhasebe.com",
    "POSTA_GONDEREN_AD": "e-Arşiv Portal"
  },

  // Cloudflare Email Sending (BETA). Alan adı 2026-09-20'de onboard edildi.
  // "remote": true EKLENMEZ — yerel `wrangler dev` gerçek e-posta göndermesin.
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}
